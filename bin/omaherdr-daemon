#!/usr/bin/env python3
# omaherdr-daemon - finds every herdr the user is attached to from this desktop,
# follows each server live, and streams one merged JSON state per change.
#
# Started by Widget.qml (stdout → the panel, stdin ← the panel):
#
#   stdout  {"generated_ts":…, "counts":{…}, "servers":[…]}       one line per change
#   args    --scan N                                              seconds between process scans (default 10)
#           --prefer CLASS                                        terminal to jump to when several host the same server
#   stdin   refresh                                               re-snapshot every server
#           go <server-key> <ws|tab|pane> <id>                    focus the terminal window, then the target
#           quit
#
# Discovery is by process: any `herdr` TUI client running on this machine
# (plain, --session NAME, --remote TARGET, `session attach NAME`) is walked up
# to the Hyprland window that hosts it, so the panel can jump straight to the
# right terminal. A local server that is running with nobody attached is
# listed too (no window to jump to). Remote servers are reached over ssh with
# the same target string the user typed; omaherdr-helper is shipped inline.
import atexit
import base64
import json
import os
import queue
import re
import selectors
import signal
from collections import deque
import shlex
import subprocess
import sys
import threading
import time

HERE = os.path.dirname(os.path.abspath(__file__))
HELPER = os.path.join(HERE, "omaherdr-helper")
NOTIFIER = os.path.join(HERE, "omaherdr-notify")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "omarchy", "omaherdr")
SINCE_FILE = os.path.join(STATE_DIR, "since.json")
DEFAULT_SOCK = "~/.config/herdr/herdr.sock"
SCAN_EVERY = 10.0         # process scan; overridable with --scan N
PREFER_TERMINAL = ""      # window-class substring that wins the ranking; --prefer CLASS
SNAPSHOT_EVERY = 60.0
DEBOUNCE = 0.25
NOTIFICATION_DEFAULTS = {"notifications": False, "notifyDone": True, "completionDelaySec": 3,
                         "snoozeMinutes": 10, "quietStart": "", "quietEnd": "", "watchSavedMachines": False, "_activeWidget": False}

events = queue.Queue()


def log(*a):
    sys.stderr.write("omaherdr: " + " ".join(str(x) for x in a) + "\n")
    sys.stderr.flush()


def run(cmd, timeout=10):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def run_bounded(cmd, timeout=5, limit=131072, cancelled=None):
    """Bound discovery output while reading and reap our own process group."""
    try:
        process = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        return None
    deadline = time.monotonic() + timeout
    data = bytearray()
    try:
        os.set_blocking(process.stdout.fileno(), False)
        with selectors.DefaultSelector() as selector:
            selector.register(process.stdout, selectors.EVENT_READ)
            while time.monotonic() < deadline:
                if cancelled is not None and cancelled.is_set():
                    return None
                if not selector.select(min(0.1, max(0, deadline - time.monotonic()))):
                    continue
                chunk = os.read(process.stdout.fileno(), min(65536, limit + 1 - len(data)))
                if not chunk:
                    while process.poll() is None and time.monotonic() < deadline:
                        if cancelled is not None and cancelled.is_set():
                            return None
                        time.sleep(0.02)
                    return data.decode("utf-8", errors="replace") if process.poll() == 0 else None
                data.extend(chunk)
                if len(data) > limit:
                    return None
        return None
    finally:
        if process.poll() is None:
            try:
                os.killpg(process.pid, signal.SIGTERM)
                process.wait(0.5)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()
            except ProcessLookupError:
                process.wait()
        process.stdout.close()


# ------------------------------------------------------------------ discovery
def hypr_clients():
    """pid → [clients]. Single-process terminals (Ghostty, foot --server) own
    every window from one pid, so a pid can map to several windows."""
    out = run(["hyprctl", "clients", "-j"])
    by_pid = {}
    try:
        for c in json.loads(out):
            if c.get("pid"):
                by_pid.setdefault(c["pid"], []).append(c)
    except ValueError:
        pass
    return by_pid


def proc_table():
    """pid → (ppid, argv)"""
    table = {}
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        pid = int(name)
        try:
            with open("/proc/%d/stat" % pid) as f:
                stat = f.read()
            with open("/proc/%d/cmdline" % pid, "rb") as f:
                argv = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
        except OSError:
            continue
        ppid = int(stat.rsplit(")", 1)[1].split()[1])
        table[pid] = (ppid, argv)
    return table


def parse_attachment(argv):
    """A herdr TUI client? → {"remote": target|None, "session": name|None}; else None."""
    if not argv or os.path.basename(argv[0]) != "herdr":
        return None
    remote, session, positional = None, None, []
    takes_value = {"--remote", "--session", "--remote-keybindings"}
    i = 1
    while i < len(argv):
        a = argv[i]
        if a in takes_value:
            val = argv[i + 1] if i + 1 < len(argv) else None
            if a == "--remote":
                remote = val
            elif a == "--session":
                session = val
            i += 2
            continue
        if a.startswith("--remote="):
            remote = a.split("=", 1)[1]
        elif a.startswith("--session="):
            session = a.split("=", 1)[1]
        elif a == "--no-session":
            return None  # monolithic: no server, no API
        elif a.startswith("-"):
            pass
        else:
            positional.append(a)
        i += 1
    if positional[:2] == ["session", "attach"] and len(positional) >= 3:
        session = positional[2]
    elif positional:
        return None  # `herdr client`, `herdr server`, CLI subcommands…
    return {"remote": remote, "session": session}


def terminal_hint(pid, window_class=""):
    """Tab/pane handle for the terminal hosting this process, from its environment.
    kitty sets KITTY_LISTEN_ON + KITTY_WINDOW_ID (remote control must be on, as
    Omarchy configures); WezTerm sets WEZTERM_UNIX_SOCKET + WEZTERM_PANE. The
    variables are inherited by anything launched from that terminal, so a hint
    only counts when it matches the class of the window that actually hosts the
    process (a Ghostty started from a kitty shell still carries KITTY_*)."""
    try:
        with open("/proc/%d/environ" % pid, "rb") as f:
            env = dict(kv.split(b"=", 1) for kv in f.read().split(b"\0") if b"=" in kv)
    except OSError:
        return None
    g = lambda k: env.get(k.encode(), b"").decode(errors="replace")
    cls = (window_class or "").lower()
    if "kitty" in cls and g("KITTY_LISTEN_ON") and g("KITTY_WINDOW_ID"):
        return {"kind": "kitty", "listen": g("KITTY_LISTEN_ON"), "window": g("KITTY_WINDOW_ID")}
    if "wezterm" in cls and g("WEZTERM_PANE"):
        return {"kind": "wezterm", "socket": g("WEZTERM_UNIX_SOCKET"), "pane": g("WEZTERM_PANE")}
    return None


def focus_terminal_tab(hint):
    """After the compositor focused the terminal window, bring the right tab/pane up."""
    if not hint:
        return
    if hint["kind"] == "kitty":
        subprocess.run(["kitten", "@", "--to", hint["listen"], "focus-window", "--match", "id:" + hint["window"]],
                       capture_output=True, timeout=5)
    elif hint["kind"] == "wezterm":
        env = dict(os.environ)
        if hint.get("socket"):
            env["WEZTERM_UNIX_SOCKET"] = hint["socket"]
        subprocess.run(["wezterm", "cli", "activate-pane", "--pane-id", hint["pane"]], capture_output=True, timeout=5, env=env)


def parse_session_list(text):
    """`herdr session list` → {name: {"status":…, "socket":…}}"""
    rows = {}
    for line in text.splitlines()[1:]:
        cols = re.split(r"\s{2,}", line.strip())
        if len(cols) >= 4:
            rows[cols[0]] = {"status": cols[1], "socket": cols[3]}
    return rows


class Discovery:
    def __init__(self):
        self.session_cache = {}  # host → (ts, rows)
        self.machine_cache = None
        self.machine_cache_at = 0.0
        self.watch_saved = False
        self.saved_cache = {}
        self.saved_pending = set()
        self.saved_results = queue.Queue()
        self.resolvers = []
        self.stopping = threading.Event()

    def machines(self):
        if time.time() - self.machine_cache_at < 60:
            return self.machine_cache
        self.machine_cache_at = time.time()
        text = run_bounded(["herdr", "machine", "list", "--json"], cancelled=self.stopping)
        try:
            rows = json.loads(text) if text is not None else None
        except ValueError:
            rows = None
        if isinstance(rows, list) and len(rows) <= 64:
            self.machine_cache = [row for row in rows if isinstance(row, dict) and row.get("enabled") is True
                                  and isinstance(row.get("target"), str) and 0 < len(row["target"]) <= 255
                                  and not row["target"].startswith("-") and not any(c.isspace() or ord(c) < 32 for c in row["target"])
                                  and isinstance(row.get("session", "default"), str)
                                  and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", row.get("session", "default"))]
        else:
            version = run_bounded(["herdr", "--version"], timeout=2, limit=256, cancelled=self.stopping) or ""
            match = re.search(r"\bherdr (\d+)\.(\d+)", version)
            old_client = match is not None and tuple(map(int, match.groups())) < (0, 9)
            self.machine_cache = [] if old_client else None
        return self.machine_cache

    def _resolve_saved(self, host):
        text = run_bounded(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", "--", host,
                            "herdr session list"], timeout=10, limit=65536, cancelled=self.stopping)
        rows = parse_session_list(text) if text is not None else {}
        self.saved_results.put((host, rows, "" if text is not None else "Saved session lookup unavailable"))
        events.put(("_discovery", None))

    def saved_sessions(self, host):
        while True:
            try:
                result_host, rows, error = self.saved_results.get_nowait()
            except queue.Empty:
                break
            self.saved_pending.discard(result_host)
            previous = self.saved_cache.get(result_host, (0, {}, ""))[1]
            self.saved_cache[result_host] = (time.time(), rows or previous, error)
            if len(self.saved_cache) > 128:
                oldest = min(self.saved_cache, key=lambda key: self.saved_cache[key][0])
                self.saved_cache.pop(oldest)
        self.resolvers = [thread for thread in self.resolvers if thread.is_alive()]
        stamp, rows, error = self.saved_cache.get(host, (0, {}, "Resolving saved session"))
        if time.time() - stamp >= 60 and host not in self.saved_pending and len(self.saved_pending) < 8:
            self.saved_pending.add(host)
            thread = threading.Thread(target=self._resolve_saved, args=(host,), daemon=True)
            self.resolvers.append(thread)
            thread.start()
        return rows, error

    def close(self):
        self.stopping.set()
        for thread in self.resolvers:
            thread.join(timeout=1)

    def sessions(self, host, herdr_bin):
        ts, rows = self.session_cache.get(host, (0, {}))
        if time.time() - ts < 60:
            return rows
        if host == "local":
            text = run([herdr_bin, "session", "list"], 5)
        else:
            # Leave a leading ~ unquoted so the remote shell expands it.
            binq = herdr_bin if re.fullmatch(r"[\w./~-]+", herdr_bin) else shlex.quote(herdr_bin)
            text = run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", "--", host, binq + " session list"], 15)
        rows = parse_session_list(text)
        self.session_cache[host] = (time.time(), rows)
        return rows

    def scan(self):
        """→ {server_key: {"host", "session", "socket", "herdr_bin", "windows": [...]}}"""
        clients = hypr_clients()
        procs = proc_table()
        found = {}
        machines = self.machines()
        possible_combined = machines is None or bool(machines)

        def windows_for(pid):
            seen = 0
            while pid > 1 and seen < 64:
                if pid in clients:
                    return [{"address": c.get("address"), "workspace": (c.get("workspace") or {}).get("id"),
                             "class": c.get("class"), "pid": pid, "title": c.get("title") or "",
                             "focus_rank": c.get("focusHistoryID", 999)} for c in clients[pid]]
                pid = procs.get(pid, (0, None))[0]
                seen += 1
            return []

        for pid, (ppid, argv) in procs.items():
            att = parse_attachment(argv)
            if not att:
                continue
            host = att["remote"] or "local"
            session = att["session"] or "default"
            herdr_bin = "herdr"
            if host != "local":
                # The ssh bridge child knows where herdr lives on the far side.
                for cpid, (cppid, cargv) in procs.items():
                    if cppid == pid and cargv and cargv[0] == "ssh":
                        m = re.search(r"exec (\S+) remote-client-bridge", " ".join(cargv))
                        if m:
                            herdr_bin = m.group(1)
                        break
            sock = DEFAULT_SOCK
            if session != "default":
                row = self.sessions(host, herdr_bin).get(session)
                if row and row.get("socket"):
                    sock = row["socket"]
            key = host + ":" + session
            entry = found.setdefault(key, {"host": host, "session": session, "socket": sock, "herdr_bin": herdr_bin, "windows": []})
            for win in windows_for(pid):
                if win["address"] in [w["address"] for w in entry["windows"]]:
                    continue
                win["terminal"] = terminal_hint(pid, win.get("class"))
                win["shared_pid"] = len(clients.get(win["pid"], [])) > 1
                win["federated"] = host == "local" and possible_combined
                entry["windows"].append(win)

        # One window can host clients for several servers (kitty tabs, a
        # single-process terminal). A window that hosts exactly one server is
        # that server's home, wherever it lives; ranking prefers it so a jump
        # lands on the same monitor every time, not on the monitor in use.
        hosted = {}
        for entry in found.values():
            for w in entry["windows"]:
                hosted[w["address"]] = hosted.get(w["address"], 0) + 1
        for entry in found.values():
            for w in entry["windows"]:
                w["servers_on_window"] = hosted.get(w["address"], 1)

        # Local servers running with no client attached.
        for name, row in self.sessions("local", "herdr").items():
            key = "local:" + name
            if row.get("status") == "running" and key not in found:
                found[key] = {"host": "local", "session": name, "socket": row.get("socket") or DEFAULT_SOCK,
                              "herdr_bin": "herdr", "windows": []}
        if self.watch_saved:
            for machine in machines or []:
                host, session = machine["target"], machine.get("session", "default")
                key = host + ":" + session
                if key not in found:
                    rows, error = self.saved_sessions(host)
                    row = rows.get(session) or {}
                    sock = row.get("socket")
                    if (not isinstance(sock, str) or len(sock) > 1024 or not sock.startswith(("/", "~/"))
                            or any(ord(char) < 32 for char in sock)):
                        sock = None
                    found[key] = {"host": host, "session": session, "socket": sock, "herdr_bin": "herdr", "windows": [],
                                  "resolve_error": error or "Saved session unavailable"}
                found[key]["saved"] = True
                found[key]["label"] = machine.get("label") if isinstance(machine.get("label"), str) else host
        return found


# ------------------------------------------------------------------ helpers
class Helper:
    """One omaherdr-helper process, local or over ssh."""

    def __init__(self, key, info):
        self.key = key
        self.info = info
        self.proc = None
        self.started = 0.0
        self.attempts = 0
        self.start()

    def command(self):
        if self.info["host"] == "local":
            return [sys.executable, HELPER, self.info["socket"]]
        with open(HELPER, "rb") as f:
            code = base64.b64encode(f.read()).decode()
        remote = "python3 -c \"import base64;exec(base64.b64decode('%s'))\" %s" % (code, shlex.quote(self.info["socket"]))
        return ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", "-o", "ServerAliveInterval=15",
                "-o", "ServerAliveCountMax=3", "--", self.info["host"], remote]

    def start(self):
        self.started = time.time()
        self.attempts += 1
        if self.info and not self.info.get("socket"):
            self.proc = None
            events.put((self.key, {"kind": "snapshot", "ok": False,
                                   "error": self.info.get("resolve_error") or "Resolving server address"}))
            return
        try:
            self.proc = subprocess.Popen(self.command(), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                         stderr=subprocess.PIPE, text=True, bufsize=1)
        except OSError as e:
            self.proc = None
            events.put((self.key, {"kind": "status", "connected": False, "message": str(e)}))
            return
        threading.Thread(target=self._pump, args=(self.proc,), daemon=True).start()
        threading.Thread(target=self._pump_err, args=(self.proc,), daemon=True).start()

    def _pump(self, proc):
        for line in proc.stdout:
            try:
                message = json.loads(line)
                if isinstance(message, dict):
                    message["_process"] = proc
                    events.put((self.key, message))
            except ValueError:
                pass
        code = proc.wait()
        events.put((self.key, {"kind": "exit", "code": code, "_process": proc}))

    def _pump_err(self, proc):
        for line in proc.stderr:
            line = line.strip()
            if line:
                log(self.key, line)

    def send(self, text):
        if not self.proc or self.proc.poll() is not None:
            return False
        try:
            self.proc.stdin.write(text + "\n")
            self.proc.stdin.flush()
            return True
        except (OSError, ValueError):
            return False

    def stop(self):
        if self.proc and self.proc.poll() is None:
            self.send("quit")
            try:
                self.proc.wait(2)
            except subprocess.TimeoutExpired:
                self.proc.kill()


class NotificationBridge(Helper):
    """Local-only, shared session-bus notification policy; never shipped over SSH."""

    def __init__(self):
        self.last_state = None
        self.pending_state = None
        self.frames = deque()
        self.offset = 0
        self.buffered = 0
        super().__init__("_attention", {})

    def command(self):
        return [sys.executable, NOTIFIER]

    def start(self):
        self.last_state = None
        self.pending_state = None
        self.frames.clear()
        self.offset = self.buffered = 0
        super().start()
        if self.proc is not None:
            os.set_blocking(self.proc.stdin.fileno(), False)

    def send(self, payload):
        return self._queue(json.dumps(payload, ensure_ascii=False, separators=(",", ":")))

    def _queue(self, serialised):
        if self.proc is None or self.proc.poll() is not None:
            return False
        self.flush()
        frame = (serialised + "\n").encode()
        if len(frame) > 1048576 or self.buffered + len(frame) > 2097152:
            return False
        self.frames.append(frame)
        self.buffered += len(frame)
        self.flush()
        return True

    def flush(self):
        if self.proc is None or self.proc.poll() is not None:
            return
        if self.pending_state is not None:
            frame = (self.pending_state + "\n").encode()
            if len(frame) > 1048576:
                self.last_state = self.pending_state
                self.pending_state = None
                events.put((self.key, {"kind": "error", "message": "Attention state exceeds the supported size"}))
            elif self.buffered + len(frame) <= 2097152:
                self.frames.append(frame)
                self.buffered += len(frame)
                self.last_state = self.pending_state
                self.pending_state = None
        for _ in range(16):
            if not self.frames:
                return
            try:
                count = os.write(self.proc.stdin.fileno(), memoryview(self.frames[0])[self.offset:self.offset + 65536])
            except OSError:
                return
            self.offset += count
            self.buffered -= count
            if self.offset == len(self.frames[0]):
                self.frames.popleft()
                self.offset = 0

    def publish(self, servers, settings):
        if settings.get("_activeWidget") is not True:
            return
        payload = {"op": "state", "state": attention_input(servers), "settings": {key: value for key, value in settings.items() if not key.startswith("_")}}
        serialised = json.dumps(payload, ensure_ascii=False, separators=(",", ":"))
        if serialised != self.last_state:
            self.pending_state = serialised
            self.flush()

    def stop(self):
        if self.proc is None or self.proc.poll() is not None:
            return
        self.send({"op": "quit"})
        deadline = time.monotonic() + 3
        while self.proc.poll() is None and time.monotonic() < deadline:
            self.flush()
            time.sleep(0.02)
        if self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(1)
            except subprocess.TimeoutExpired:
                self.proc.kill()
                self.proc.wait()


def identifier(value, limit=128):
    return value if isinstance(value, str) and 0 < len(value) <= limit and all(ord(c) >= 32 and ord(c) != 127 and not 0xD800 <= ord(c) <= 0xDFFF and not c.isspace() for c in value) else ""


def notification_text(value, limit=80):
    if not isinstance(value, str):
        return ""
    return "".join(c for c in value[:limit] if ord(c) >= 32 and ord(c) != 127 and not 0xD800 <= ord(c) <= 0xDFFF and c not in "<>&")


def attention_input(servers):
    """Only bounded identity/status metadata crosses the local notification bus."""
    result = {"servers": [], "truncated": len(servers) > 64}
    remaining = 256
    for key in sorted(servers)[:64]:
        view = servers[key].view()
        snapshot = servers[key].notification_snapshot or {}
        result["truncated"] = result["truncated"] or snapshot.get("truncated", False)
        agents = []
        source_agents = snapshot.get("agents", [])
        if len(source_agents) > remaining:
            result["truncated"] = True
        for agent in source_agents[:remaining]:
            if remaining == 0:
                result["truncated"] = True
                break
            if not all(identifier(agent.get(field)) for field in ("pane_id", "workspace_id", "tab_id")):
                continue
            row = {field: identifier(agent.get(field)) for field in ("pane_id", "workspace_id", "tab_id", "terminal_id")}
            row.update({field: notification_text(agent.get(field)) for field in ("agent", "name")})
            row["agent_status"] = agent.get("agent_status") if agent.get("agent_status") in ("blocked", "done", "working", "idle", "unknown") else "unknown"
            sequence = agent.get("state_change_seq")
            if isinstance(sequence, int) and not isinstance(sequence, bool) and 0 <= sequence < 2 ** 64:
                row["state_change_seq"] = sequence
            agents.append(row)
            remaining -= 1
        workspace_ids = {agent["workspace_id"] for agent in agents}
        tab_ids = {agent["tab_id"] for agent in agents}
        workspaces = [{"workspace_id": row["workspace_id"], "label": notification_text(row.get("label"))}
                      for row in snapshot.get("workspaces", [])[:512] if isinstance(row, dict) and row.get("workspace_id") in workspace_ids]
        tabs = [{"tab_id": row["tab_id"], "workspace_id": identifier(row.get("workspace_id")), "label": notification_text(row.get("label"))}
                for row in snapshot.get("tabs", [])[:512] if isinstance(row, dict) and row.get("tab_id") in tab_ids]
        result["servers"].append({"key": identifier(key, 512), "host": notification_text(view.get("host")),
                                  "label": notification_text(view.get("label")), "session": notification_text(view.get("session")),
                                  "ok": view["ok"], "connected": view["connected"], "can_open": view["can_open"],
                                  "snapshot": {"agents": agents, "workspaces": workspaces, "tabs": tabs}})
    return result


def show_attention(filter_text=""):
    sys.stdout.write(json.dumps({"kind": "ui", "action": "show_attention", "filter": notification_text(filter_text)}) + "\n")
    sys.stdout.flush()


# ------------------------------------------------------------------ state
PANE_FIELDS = ("pane_id", "terminal_id", "tab_id", "workspace_id", "label", "agent", "agent_status", "focused", "terminal_title_stripped", "cwd")
AGENT_FIELDS = ("pane_id", "terminal_id", "state_change_seq", "tab_id", "workspace_id", "agent", "agent_status", "focused", "terminal_title_stripped", "cwd", "name")


def slim(obj, fields):
    return {k: obj.get(k) for k in fields if k in obj}


class Server:
    def __init__(self, key, info):
        self.key = key
        self.info = info
        self.ok = False
        self.error = None
        self.connected = False
        self.snapshot = None
        self.notification_snapshot = None
        self.status = {}          # pane_id → last agent_status seen
        self.since = {}           # pane_id → ts the status was first seen
        self.want_snapshot_at = None
        self.last_snapshot = 0.0

    def apply_snapshot(self, msg, now):
        if not msg.get("ok"):
            self.ok = False
            self.error = msg.get("error") or "unavailable"
            return
        snap = msg.get("snapshot") or {}
        self.ok = True
        self.error = None
        self.last_snapshot = now
        panes = [slim(p, PANE_FIELDS) for p in snap.get("panes", [])]
        agents = [slim(a, AGENT_FIELDS) for a in snap.get("agents", [])]
        live = set()
        for p in panes:
            if not p.get("agent"):
                continue
            live.add(p["pane_id"])
            self.note_status(p["pane_id"], p.get("agent_status"), now)
        for pid in list(self.status):
            if pid not in live:
                self.status.pop(pid, None)
                self.since.pop(pid, None)
        self.snapshot = {
            "version": snap.get("version"),
            "focused_workspace_id": snap.get("focused_workspace_id"),
            "focused_tab_id": snap.get("focused_tab_id"),
            "focused_pane_id": snap.get("focused_pane_id"),
            "workspaces": snap.get("workspaces", []),
            "tabs": snap.get("tabs", []),
            "panes": panes,
            "agents": agents,
        }
        # Status events lack state_change_seq. Keep an authoritative alert
        # snapshot separate from the bar's immediate in-place event updates.
        self.notification_snapshot = {"agents": [dict(agent) for agent in agents[:256]],
                                      "workspaces": self.snapshot["workspaces"], "tabs": self.snapshot["tabs"],
                                      "truncated": len(agents) > 256}

    def note_status(self, pane_id, status, now):
        if self.status.get(pane_id) != status:
            self.status[pane_id] = status
            self.since[pane_id] = now

    def apply_event(self, msg, now):
        """Cheap in-place update so the bar flips immediately; a snapshot follows."""
        ev, data = msg.get("event"), msg.get("data") or {}
        if ev == "pane.agent_status_changed" and self.snapshot:
            pid, st = data.get("pane_id"), data.get("agent_status")
            for coll in ("panes", "agents"):
                for p in self.snapshot[coll]:
                    if p.get("pane_id") == pid:
                        p["agent_status"] = st
            self.note_status(pid, st, now)
        self.want_snapshot_at = now + DEBOUNCE

    def view(self):
        return {
            "key": self.key, "host": self.info["host"], "session": self.info["session"],
            "label": self.info.get("label") or (self.info["host"] if self.info["host"] != "local" else os.uname().nodename),
            "ok": self.ok, "error": self.error, "connected": self.connected,
            "windows": self.info.get("windows", []),
            "can_open": any(window.get("address") and not window.get("federated", False) for window in self.info.get("windows", [])),
            "saved": bool(self.info.get("saved")),
            "snapshot": self.snapshot,
            "since": self.since,
            "snapshot_ts": self.last_snapshot,
        }


def counts(servers):
    c = {"blocked": 0, "done": 0, "working": 0, "idle": 0, "unknown": 0, "agents": 0, "servers": 0, "windows": 0}
    for s in servers:
        if not s.ok or not s.snapshot:
            continue
        c["servers"] += 1
        c["windows"] += len(s.info.get("windows", []))
        for a in s.snapshot["agents"]:
            st = a.get("agent_status") or "unknown"
            c[st if st in c else "unknown"] += 1
            c["agents"] += 1
    return c


def load_since():
    try:
        with open(SINCE_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_since(servers):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        data = {s.key: {"status": s.status, "since": s.since} for s in servers.values()}
        tmp = SINCE_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, SINCE_FILE)
    except OSError:
        pass


# ------------------------------------------------------------------ main
def stdin_reader():
    for line in sys.stdin:
        events.put(("_stdin", line.strip()))
    events.put(("_stdin", "quit"))


def emit(servers, discovered_ts, attention, notifier, settings):
    views = [servers[k].view() for k in sorted(servers)]
    out = {"generated_ts": time.time(), "scan_ts": discovered_ts, "counts": counts(list(servers.values())), "servers": views, "attention": attention}
    sys.stdout.write(json.dumps(out, separators=(",", ":")) + "\n")
    sys.stdout.flush()
    notifier.publish(servers, settings)


def main():
    global SCAN_EVERY, PREFER_TERMINAL
    args = sys.argv[1:]
    if "--prefer" in args:
        try:
            PREFER_TERMINAL = args[args.index("--prefer") + 1].strip().lower()
        except IndexError:
            pass
        if PREFER_TERMINAL == "auto":
            PREFER_TERMINAL = ""
    if "--scan" in args:
        try:
            SCAN_EVERY = max(2.0, float(args[args.index("--scan") + 1]))
        except (IndexError, ValueError):
            pass
    discovery = Discovery()
    servers, helpers = {}, {}
    notifier = NotificationBridge()
    notification_settings = dict(NOTIFICATION_DEFAULTS)
    attention = {"available": False, "enabled": False, "quiet": False, "error": "Starting attention backend", "entries": [], "muted_workspaces": [], "counts": {}}
    stopping = False

    def request_shutdown(signum, frame):
        nonlocal stopping
        stopping = True

    def shutdown():
        discovery.close()
        for helper in helpers.values():
            helper.stop()
        notifier.stop()

    signal.signal(signal.SIGTERM, request_shutdown)
    signal.signal(signal.SIGINT, request_shutdown)
    atexit.register(shutdown)
    remembered = load_since()
    threading.Thread(target=stdin_reader, daemon=True).start()

    last_scan = 0.0
    dirty_at = None
    scan_ts = 0.0
    emit(servers, scan_ts, attention, notifier, notification_settings)

    while not stopping:
        now = time.time()
        notifier.flush()
        if notifier.proc is None or notifier.proc.poll() is not None:
            if now - notifier.started >= min(60, 2 ** min(notifier.attempts, 6)):
                notifier.start()
                dirty_at = now
        if now - last_scan >= SCAN_EVERY:
            last_scan = now
            found = discovery.scan()
            scan_ts = now
            for key in list(servers):
                if key not in found:
                    helpers.pop(key).stop()
                    servers.pop(key)
                    dirty_at = now
            for key, info in found.items():
                if key not in servers:
                    servers[key] = Server(key, info)
                    mem = remembered.get(key)
                    if mem:
                        servers[key].status = dict(mem.get("status", {}))
                        servers[key].since = dict(mem.get("since", {}))
                    helpers[key] = Helper(key, info)
                    dirty_at = now
                elif servers[key].info != info:
                    address_changed = servers[key].info.get("socket") != info.get("socket")
                    servers[key].info = info
                    if address_changed:
                        helpers[key].stop()
                        servers[key].connected = False
                        servers[key].ok = False
                        helpers[key] = Helper(key, info)
                    else:
                        helpers[key].info = info
                    dirty_at = now
            # Safety net: periodic full snapshots.
            for key, s in servers.items():
                if s.ok and now - s.last_snapshot > SNAPSHOT_EVERY:
                    helpers[key].send("snapshot")

        # Helpers that died: restart with backoff (ssh drops, server restarts).
        for key, h in helpers.items():
            if h.proc is None or h.proc.poll() is not None:
                wait = min(60.0, 2.0 * (2 ** min(h.attempts, 5)))
                if now - h.started >= wait:
                    h.start()

        for key, s in servers.items():
            if s.want_snapshot_at is not None and now >= s.want_snapshot_at:
                s.want_snapshot_at = None
                helpers[key].send("snapshot")

        try:
            key, msg = events.get(timeout=0.2)
        except queue.Empty:
            key, msg = None, None
        if isinstance(msg, dict) and "_process" in msg:
            owner = notifier if key == "_attention" else helpers.get(key)
            if owner is None or msg["_process"] is not owner.proc:
                continue

        if key == "_stdin":
            cmd = msg.split()
            if not cmd:
                pass
            elif cmd[0] == "quit":
                break
            elif cmd[0] == "refresh":
                last_scan = 0.0
                discovery.machine_cache_at = 0
                for h in helpers.values():
                    h.send("snapshot")
            elif cmd[0] == "settings" and len(msg) <= 16384:
                try:
                    settings = json.loads(msg.partition(" ")[2])
                    if not isinstance(settings, dict):
                        raise ValueError("settings must be an object")
                    was_active = notification_settings["_activeWidget"]
                    notification_settings.update({name: settings[name] for name in NOTIFICATION_DEFAULTS if name in settings})
                    notification_settings["_activeWidget"] = settings.get("_activeWidget", True) is True
                    if was_active and not notification_settings["_activeWidget"]:
                        notifier.stop()
                    watch_saved = notification_settings["watchSavedMachines"] is True and notification_settings["_activeWidget"]
                    if discovery.watch_saved != watch_saved:
                        discovery.watch_saved = watch_saved
                        last_scan = 0
                    dirty_at = now
                except (ValueError, TypeError):
                    log("invalid notification settings message")
            elif cmd[0] == "attention" and len(msg) <= 4096:
                try:
                    command = json.loads(msg.partition(" ")[2])
                    action, target = command.get("action"), command.get("target", "")
                    if action not in ("open", "show", "snooze", "unsnooze", "mute", "unmute", "clear_mutes") or not isinstance(target, str) or len(target) > 256:
                        raise ValueError("invalid attention command")
                    if not notifier.send({"op": "command", "action": action, "target": target}):
                        attention = dict(attention, available=False, error="Attention backend unavailable or busy")
                        dirty_at = now
                except (ValueError, TypeError, AttributeError):
                    log("invalid attention command")
            elif cmd[0] in ("go", "go-notification") and len(cmd) >= 4:
                skey, kind, target = cmd[1], cmd[2], cmd[3]
                s = servers.get(skey)
                if s:
                    wins = s.info.get("windows") or []
                    if cmd[0] == "go-notification":
                        terminal_id = cmd[4] if len(cmd) == 5 else ""
                        agents = (s.snapshot or {}).get("agents", [])
                        valid_target = any(agent.get("pane_id") == target and (agent.get("terminal_id") or "") == terminal_id for agent in agents)
                        wins = [window for window in wins if not window.get("federated") and re.fullmatch(r"0x[0-9a-fA-F]+", str(window.get("address", "")))]
                        if kind != "pane" or not s.ok or not s.connected or not valid_target or not wins:
                            show_attention()
                            continue
                    if len(wins) > 1:
                        # Several candidate windows (two clients on one server, or a
                        # single-process terminal like Ghostty / foot --server owning
                        # every window). herdr titles its terminal "{hostname}: {workspace}",
                        # so prefer a title naming the server's focused space, then the
                        # host, then a window that hosts this server alone, then a window
                        # on the current workspace, then most recent focus. The dedicated
                        # window wins before the current workspace does: a server parked on
                        # a second monitor must be reached there, not reopened next to us.
                        snap = s.snapshot or {}
                        label = next((w.get("label", "") for w in snap.get("workspaces", []) if w.get("workspace_id") == snap.get("focused_workspace_id")), "")
                        hostl = s.info["host"] if s.info["host"] != "local" else os.uname().nodename
                        try:
                            cur_ws = json.loads(run(["hyprctl", "activeworkspace", "-j"])).get("id")
                        except ValueError:
                            cur_ws = None
                        wins = sorted(wins, key=lambda w: (bool(PREFER_TERMINAL) and PREFER_TERMINAL in (w.get("class") or "").lower(),
                                                           bool(label) and label in w.get("title", ""), hostl in w.get("title", ""),
                                                           int(w.get("servers_on_window", 1)) == 1,
                                                           w.get("workspace") == cur_ws, -int(w.get("focus_rank", 999))), reverse=True)
                    if wins:
                        # Hyprland ≥ 0.56 dispatches Lua; older builds take the classic form.
                        addr = "address:" + str(wins[0]["address"])
                        r = subprocess.run(["hyprctl", "dispatch", 'hl.dsp.focus({ window = "%s" })' % addr], capture_output=True, text=True)
                        if "error" in (r.stdout + r.stderr).lower():
                            subprocess.run(["hyprctl", "dispatch", "focuswindow", addr], capture_output=True)
                        try:
                            focus_terminal_tab(wins[0].get("terminal"))
                        except (OSError, subprocess.TimeoutExpired) as e:
                            log("terminal tab focus failed:", e)
                    method, params = {
                        "ws": ("workspace.focus", {"workspace_id": target}),
                        "tab": ("tab.focus", {"tab_id": target}),
                        "pane": ("pane.focus", {"pane_id": target}),
                    }.get(kind, (None, None))
                    if method:
                        helpers[skey].send("rpc " + json.dumps({"id": cmd[0], "method": method, "params": params}))
        elif key == "_discovery":
            last_scan = 0
        elif key == "_attention":
            if msg.get("kind") == "attention" and isinstance(msg.get("attention"), dict):
                attention = msg["attention"]
                dirty_at = now
            elif msg.get("kind") in ("error", "exit", "status"):
                attention = dict(attention, available=False, error=notification_text(msg.get("message")) or "Attention backend unavailable")
                dirty_at = now
            elif msg.get("kind") == "action":
                if msg.get("action") == "show_attention":
                    show_attention(msg.get("filter", ""))
                elif msg.get("action") == "go":
                    server_key, pane_id, terminal_id = msg.get("server"), msg.get("id"), msg.get("terminal_id")
                    if identifier(server_key, 512) and identifier(pane_id) and identifier(terminal_id):
                        events.put(("_stdin", "go-notification " + server_key + " pane " + pane_id + " " + terminal_id))
                    else:
                        show_attention()
        elif key in servers:
            s = servers[key]
            kind = msg.get("kind")
            if kind == "snapshot":
                s.apply_snapshot(msg, time.time())
                s.connected = s.ok
                dirty_at = time.time()
                save_since(servers)
            elif kind == "event":
                s.apply_event(msg, time.time())
                dirty_at = time.time()
            elif kind == "status":
                s.connected = bool(msg.get("connected"))
                if not s.connected and msg.get("message"):
                    log(key, msg["message"])
                dirty_at = time.time()
            elif kind == "rpc":
                if msg.get("error"):
                    log(key, "rpc", msg.get("method"), msg["error"])
                    if msg.get("id") == "go-notification":
                        show_attention()
                elif msg.get("id") == "go-notification":
                    sys.stdout.write(json.dumps({"kind": "ui", "action": "close_attention"}) + "\n")
                    sys.stdout.flush()
            elif kind == "exit":
                s.connected = False
                s.ok = False
                s.error = "helper exited (%s)" % msg.get("code")
                dirty_at = time.time()

        if dirty_at is not None and time.time() - dirty_at >= 0.05:
            emit(servers, scan_ts, attention, notifier, notification_settings)
            dirty_at = None

    shutdown()
    atexit.unregister(shutdown)


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        pass
